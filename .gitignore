# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
*.apk
*.aab
*.jks
*.keystore
keystore.properties

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# user accounts (contains password hashes — do not commit)
/data/users.json

# procedure run records (runtime audit data)
/data/procedure-runs.json

# notification recipients (contains Pushover user keys)
/data/notify-recipients.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# imported 3D models (user content, can be large)
/data/models/
/data/models.json

# 로컬 TLS 인증서 (개인키 포함 — 절대 커밋 금지)
certs/

# 배포된 루트 CA — 기기마다 mkcert 로 새로 만드는 것이라 저장소에 넣지 않는다.
# (공개 인증서라 유출 위험은 없지만, 이 Mac 전용 산출물이고 사용자명이 들어간다)
public/rootCA.crt
public/rootCA.pem

# 계측 이력 — 이 배에서 수집된 실측값 (기기마다 다르고 용량이 계속 는다)
data/history/
