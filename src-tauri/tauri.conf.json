{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Boat Maintenance Display",
  "version": "0.1.0",
  "identifier": "io.boatmaintenance.display",
  "build": {
    "frontendDist": "http://192.168.1.146:3100",
    "devUrl": "http://localhost:3100",
    "beforeDevCommand": "npm run dev:lan -- -p 3100"
  },
  "app": {
    "windows": [
      {
        "title": "Boat Maintenance",
        "width": 800,
        "height": 480,
        "resizable": true,
        "fullscreen": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
